# Copy this file to .env and paste your MongoDB Atlas connection string.
# Atlas -> your cluster -> Connect -> Drivers -> copy the string, then replace <db_password>.
MONGO_URI=mongodb+srv://<username>:<db_password>@<cluster-name>.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=flask_assignment
MONGO_COLLECTION=submissions
